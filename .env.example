# Copy to .env and adjust as needed:  cp .env.example .env
# Every value below is the DEFAULT already used in docker-compose.

# Ports exposed on the host
MONO_PORT=8081
MS_PORT=8082
GRAFANA_PASSWORD=tokoku

# Workload (must be the SAME for both architectures)
# PBKDF2 iterations for password hashing -> CPU cost of the login endpoint (~25ms/login @100000)
PASSWORD_HASH_ITERATIONS=100000
# Simulated CPU "fraud check" on every checkout (~5ms/order @2000)
FRAUD_CHECK_ROUNDS=2000
JWT_SECRET=tokoku-demo-secret

# MONOLITH resource budget (app total = 2 CPU / 1 GB)
MONO_CPUS=2
MONO_MEMORY=1g
# Node.js workers. Match MONO_CPUS so every core is used.
MONO_WORKERS=2
MONO_DB_POOL_MAX=10
# sync  = checkout waits for the email to be sent (email down -> checkout fails)
# async = email is sent in the background (in-memory queue)
MONO_NOTIFICATION_MODE=sync

# MICROSERVICES resource budget (app total = 2 CPU / 1 GB)
USER_CPUS=0.3
PRODUCT_CPUS=0.5
ORDER_CPUS=0.6
PAYMENT_CPUS=0.3
NOTIFICATION_CPUS=0.3
# Extra infrastructure overhead that only microservices need
MQ_CPUS=0.5
# async = RabbitMQ event (default), sync = direct HTTP to notification-service
MS_NOTIFICATION_MODE=async

# Database (same for both architectures)
DB_CPUS=1
DB_MEMORY=1g

# Database ports on the host for DB clients (Navicat, DBeaver, psql)
MONO_DB_PORT=15432
MS_DB_PORT=15433
# 127.0.0.1 = local only (recommended). Use an SSH tunnel to reach it on a VPS.
DB_BIND=127.0.0.1
