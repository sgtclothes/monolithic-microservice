          "expr": "sum by (container_label_com_docker_compose_project, name) (rate(container_cpu_cfs_throttled_periods_total{container_label_com_docker_compose_project=~\"$project\", name!=\"\"}[$__rate_interval])) / sum by (container_label_com_docker_compose_project, name) (rate(container_cpu_cfs_periods_total{container_label_com_docker_compose_project=~\"$project\", name!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{name}}",
          "refId": "A"
