{
  "uid": "tokoku-containers",
  "title": "TokoKu: Containers (cAdvisor)",
  "description": "CPU, memory, throttling, and network per Docker container.",
  "tags": [
    "tokoku"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Compose project",
        "type": "custom",
        "query": "tokoku-mono,tokoku-ms,tokoku-infra",
        "multi": true,
        "includeAll": true,
        "allValue": "tokoku-mono|tokoku-ms|tokoku-infra",
        "current": {
          "text": [
            "tokoku-mono",
            "tokoku-ms"
          ],
          "value": [
            "tokoku-mono",
            "tokoku-ms"
          ]
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": false
          },
          {
            "text": "tokoku-mono",
            "value": "tokoku-mono",
            "selected": true
          },
          {
            "text": "tokoku-ms",
            "value": "tokoku-ms",
            "selected": true
          },
          {
            "text": "tokoku-infra",
            "value": "tokoku-infra",
            "selected": false
