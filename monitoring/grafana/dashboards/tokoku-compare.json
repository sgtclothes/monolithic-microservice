{
  "uid": "tokoku-compare",
  "title": "TokoKu: Monolith vs Microservices",
  "description": "Side-by-side comparison for analyzing experiment results.",
  "tags": [
    "tokoku"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "text",
      "title": "How to use",
      "options": {
        "mode": "markdown",
        "content": "Run the **same** k6 scenario against the monolith and then microservices, then pick a time range that covers both. The *stat* panels compute values **over the selected time range**, so pick a range that sits inside the steady load phase (drop the first warm-up minute) to keep it fair."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "type": "row",
      "title": "Summary over the selected time range",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "p95 GET /products",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, arch) (increase(http_request_duration_seconds_bucket{route=\"/api/products\", method=\"GET\", arch=~\"monolith|microservices\"}[$__range])))",
          "legendFormat": "{{arch}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": null,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 5
      }
    },
